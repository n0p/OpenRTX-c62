#Build dirs
/build*

# Meson wrap lock file
subprojects/.wraplock

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Binaries
*.bin
*.elf
*.hex
*.map

# Python byte-compiled
*/__pycache__

# Python virtual environments
.venv/

# Kdevelop files
*.kdev4
.kdev4/

# gutentags
tags


# subprojects
subprojects/radio_tool
subprojects/codec2
subprojects/tinyusb
subprojects/XPowersLib
subprojects/catch2

# ignore log files
*.log

# ignore linux openrtx emulator history file
.emulatorsh_history

# Compiled script
scripts/get_demod_log

# OpenRTX Codeplugs
*.rtxc

# Host builds of the TETRA engine's harnesses and of libtetra itself
/build-host/
/build-qemu/
/build-lt-*/

# Host bench of the packet modem: the test binary and the WAVs it generates for
# direwolf are rebuilt by tests/host/kiss_loop/run.sh
/tests/host/kiss_loop/build/
/build-qemu-kiss/

# dPMR working material: the ETSI PDFs, the DSDcc and dsd-neo checkouts used as
# references and the captures the receiver was developed against.  Sources and
# copyrights are their own; nothing of it is distributed with the firmware.
/dpmr_spec/

# D-STAR vocoder: the reference PCM of the test bank is regenerated with
# lib/dstar_vocoder/tests/ref/ref_dstar.c against mbelib-neo (see
# docs/RX_DSTAR.md); the frame bank itself is committed, like the DMR one.
lib/dstar_vocoder/tests/data/*_ref.pcm
